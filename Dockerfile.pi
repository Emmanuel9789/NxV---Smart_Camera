FROM python:3.11-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libopenblas-dev liblapack-dev \
    libx11-dev libboost-python-dev libboost-thread-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN pip install --no-cache-dir wheel setuptools numpy==1.26.4
RUN pip install --no-cache-dir dlib==19.24.4 face_recognition==1.3.0
RUN pip install --no-cache-dir \
    torch==2.3.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir ultralytics==8.2.0 --no-deps
RUN pip install --no-cache-dir \
    opencv-python-headless pillow pyyaml tqdm \
    scipy matplotlib seaborn psutil py-cpuinfo pandas

FROM python:3.11-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev \
    libgomp1 libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages \
                    /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN pip install --no-cache-dir \
    flask==3.0.3 \
    twilio==9.2.3 \
    requests==2.32.3 \
    Pillow==10.3.0 \
    scipy==1.13.0

WORKDIR /app
COPY . .
RUN mkdir -p evidence/clips evidence/snapshots datasets logs

ENV PYTHONPATH=/app
EXPOSE 5000
CMD ["python", "-u", "main.py"]